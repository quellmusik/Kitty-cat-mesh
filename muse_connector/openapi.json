{
  "openapi": "3.0.0",
  "info": {
    "title": "Kitty Cat (Muse AI) Leader Mesh - Full - Always-On - Low-Usage Safe",
    "version": "6.1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "status",
        "summary": "Mesh status - Kitty Cat leader"
      }
    },
    "/bots": {
      "get": {
        "operationId": "listBots",
        "summary": "List bots"
      }
    },
    "/bots/add": {
      "post": {
        "operationId": "addBot",
        "summary": "Add member to mesh - easy flexibility"
      }
    },
    "/bots/remove": {
      "post": {
        "operationId": "removeBot",
        "summary": "Remove member from mesh"
      }
    },
    "/history": {
      "get": {
        "operationId": "sharedHistory",
        "summary": "Shared history - awesome"
      }
    },
    "/transfers": {
      "get": {
        "operationId": "listTransfers",
        "summary": "All transfers"
      }
    },
    "/transfer": {
      "post": {
        "operationId": "transfer",
        "summary": "Transfer any type - videos, music, playlists, docs, code, etc"
      }
    },
    "/job": {
      "post": {
        "operationId": "kittyCatDirects",
        "summary": "Kitty Cat directs work for optimal outcome - just executes"
      }
    },
    "/auto_chat": {
      "post": {
        "operationId": "autoChat",
        "summary": "Bots auto chat - max turns guarded to avoid massive usage"
      }
    },
    "/chat": {
      "get": {
        "operationId": "getAutoChat",
        "summary": "Get auto chat log"
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Health check"
      }
    },
    "/manifest": {
      "get": {
        "operationId": "manifest",
        "summary": "Full mesh manifest - bots, endpoints, version"
      }
    },
    "/jobs": {
      "get": {
        "operationId": "listJobs",
        "summary": "List all directed jobs"
      }
    },
    "/inbox": {
      "get": {
        "operationId": "inbox",
        "summary": "Per-bot inbox - messages and jobs addressed to a bot (?bot=PRISM)"
      }
    },
    "/prism/status": {
      "get": {
        "operationId": "prismStatus",
        "summary": "Prism status and last activity"
      }
    },
    "/creative-toolkit": {
      "get": {
        "operationId": "creativeToolkit",
        "summary": "Creative capabilities listing"
      }
    },
    "/generate-video": {
      "post": {
        "operationId": "generateVideo",
        "summary": "Queue a video clip generation job for PRISM (Meta AI)"
      }
    },
    "/push-from-metaai": {
      "post": {
        "operationId": "pushFromMetaAI",
        "summary": "Prism pushes finished work back from the Meta AI side"
      }
    }
  }
}